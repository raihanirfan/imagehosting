{
  "name": "image-hosting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/style.css --content \"./public/**/*.{html,js},./src/**/*.{ts,js}\" --minify && node scripts/update_frontend.js",
    "backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup_d1.ps1",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
