# Cloudflare Wrangler Local Environment Variables Template (.dev.vars)
# Copy this file to .dev.vars for local development. Never commit .dev.vars!

ENVIRONMENT=development
UPLOAD_SECRET=
TURNSTILE_SECRET_KEY=

# Storage Adapters (Optional / Fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_FOLDER_ID=
PIXELDRAIN_API_KEY=
BUZZHEAVIER_API_KEY=

# Security & Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_IPS=
BLOCKED_IPS=
